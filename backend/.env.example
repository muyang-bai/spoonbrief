# ===== 应用 =====
APP_NAME=一勺热点
APP_ENV=production
APP_URL=https://your-domain.com
SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
DEFAULT_TZ=Asia/Shanghai

# ===== 数据库（MySQL 8）=====
USE_SQLITE=false
DATABASE_URL=mysql+pymysql://DB_USER:CHANGE_ME@DB_HOST:3306/DB_NAME?charset=utf8mb4

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== 调度 =====
# 生产用 Celery beat/worker；单机开发可设 true 启用进程内调度
ENABLE_LOCAL_SCHEDULER=false

# ===== 加密（Fernet key，32 字节 base64）=====
ENCRYPTION_KEY=CHANGE_ME_32_BYTES_BASE64

# ===== SMTP =====
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=noreply@your-domain.com
SMTP_PASSWORD=CHANGE_ME_SMTP_AUTH_CODE
SMTP_FROM_EMAIL=noreply@your-domain.com
SMTP_FROM_NAME=一勺热点
SMTP_USE_SSL=true

# ===== AI =====
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
AI_DEFAULT_PROVIDER=deepseek
AI_ENABLED=true

# ===== 信息源（可选）=====
NEWSAPI_KEY=
BING_NEWS_KEY=
DAILYHOT_BASE_URL=https://api.v2.aicfe.cn

# ===== 人机验证（可选）=====
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# ===== 管理员 =====
ADMIN_NICKNAME=管理员
ADMIN_EMAIL=admin@your-domain.com
ADMIN_INIT_PASSWORD=CHANGE_ME

# ===== CORS =====
CORS_ORIGINS=https://your-domain.com

# ===== 与 AiLifeOS 的 HMAC 互通（不接可留空）=====
AILIFEOS_BASE_URL=
ADMIN_HMAC_SECRET=
INTEGRATION_HMAC_SECRET=
HOTBRIEF_HMAC_SECRET=
